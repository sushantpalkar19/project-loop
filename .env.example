[TEMPLATE]
[TEMPLATE]
# ──────────────────────────────────────────────
# Project LOOP — Environment Variables Template
# ──────────────────────────────────────────────
#
# Copy this file to .env.local (for Next.js) or .env (for Prisma CLI).
# NEVER commit .env or .env.local to version control.
#
# Prisma CLI reads from .env by default (via prisma.config.ts).
# Next.js reads from .env.local automatically.

# ── Database (Prisma + PostgreSQL) ─────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/project_loop?schema=public"

# ── Auth.js / NextAuth ────────────────────────
# REQUIRED for authentication. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-a-real-one"

# ── OAuth Providers (add as needed) ───────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── Claude AI (Anthropic) ─────────────────────
# REQUIRED for AI sentiment classification (Feedback Inbox). Get your key from https://console.anthropic.com/
# NOTE: Not required for Ask LOOP (which uses Gemini only)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ── Google Gemini ─────────────────────────────
# REQUIRED for Ask LOOP (embeddings + answer generation). Get your key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ── App ───────────────────────────────────────
NODE_ENV="development"
